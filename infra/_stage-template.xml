<!--
================================================================================
STAGE [XX]: [STAGE NAME] - [Brief Description]
================================================================================
Pipeline Position: [XX] of [XX] ([FIRST/MIDDLE/FINAL] STAGE)
Receives: [What this stage receives as input]
Produces: [What this stage outputs for the next stage or final delivery]
================================================================================

INSTRUCTIONS FOR USING THIS TEMPLATE:
1. Copy this file and rename it to stage-X-[name].xml (e.g., stage-1-analysis.xml)
2. Replace all [PLACEHOLDERS] with actual values
3. Remove this instruction block
4. Customize each element for your stage's specific needs

================================================================================
-->

<!-- ============================================================
     INFRASTRUCTURE COMPONENTS (shared across all stages)
     ============================================================ -->
{{include:infra/thinking-framework.xml}}
{{include:infra/response-schema.xml}}
{{include:infra/approach.xml}}

<!-- ============================================================
     INPUT SCHEMA - What this stage receives
     ============================================================ -->
<input_schema>
  <description>[Brief description of expected input]</description>
  {
    "field_1": "type - Description of field",
    "field_2": "type - Description of field",
    "field_3": {
      "nested_field": "type - Description",
      "another_field": "type - Description"
    },
    "optional_field": "type | null - Optional field description"
  }
</input_schema>

<!-- ============================================================
     OUTPUT SCHEMA - What this stage produces
     Inherits base fields from response_schema, adds stage-specific output
     ============================================================ -->
<output_schema inherits="response_schema">
  <description>[Brief description of what this stage outputs]</description>
  {
    "stage_specific_output": {
      "deliverable_1": {
        "field_a": "type - Description",
        "field_b": "type - Description"
      },
      "deliverable_2": [
        {
          "item_field_1": "type - Description",
          "item_field_2": "type - Description"
        }
      ]
    }
  }
</output_schema>

<!-- ============================================================
     STAGE ELEMENT 1: IDENTITY
     Define WHO is doing this work - role and expertise
     ============================================================ -->
<identity>
  <role>[Job title and specialization for this stage]</role>
  <expertise>
    <skill>[Skill 1 - specific capability needed]</skill>
    <skill>[Skill 2 - specific capability needed]</skill>
    <skill>[Skill 3 - specific capability needed]</skill>
  </expertise>
</identity>

<!-- ============================================================
     STAGE ELEMENT 2: MISSION
     Define WHAT success looks like for this stage
     ============================================================ -->
<mission>
  <primary_objective>
    [Clear statement of the main goal this stage must achieve.
    What is the single most important outcome?]
  </primary_objective>

  <success_criteria>
    <!-- priority: critical = must achieve, high = should achieve, medium = nice to have -->
    <criterion id="1" priority="critical">[Criterion that MUST be met]</criterion>
    <criterion id="2" priority="critical">[Another critical criterion]</criterion>
    <criterion id="3" priority="high">[Important but not blocking]</criterion>
    <criterion id="4" priority="medium">[Nice to have]</criterion>
  </success_criteria>

  <behavioral_qualities>
    <quality>[quality-name] - [Description of how to approach work]</quality>
    <quality>[quality-name] - [Description of how to approach work]</quality>
    <quality>[quality-name] - [Description of how to approach work]</quality>
  </behavioral_qualities>

  <deliverables>
    <!-- type: primary = required output, supporting = helpful but optional -->
    <deliverable type="primary">[Main deliverable 1]</deliverable>
    <deliverable type="primary">[Main deliverable 2]</deliverable>
    <deliverable type="supporting">[Supporting deliverable]</deliverable>
  </deliverables>
</mission>

<!-- ============================================================
     STAGE ELEMENT 3: TASKS
     Define HOW to accomplish the mission - ordered sequence of work
     ============================================================ -->
<tasks>
  <task order="1" name="[task_name]">
    <description>[What this task accomplishes]</description>
    <!-- Include ONE of the following based on task type: -->

    <!-- For SEARCH tasks (gathering external data): -->
    <searches>
      <search>"[Search query pattern 1]"</search>
      <search>"[Search query pattern 2]"</search>
    </searches>

    <!-- For ANALYSIS tasks (evaluating data): -->
    <!--
    <analysis_points>
      - [What to look for 1]
      - [What to look for 2]
      - [What to look for 3]
    </analysis_points>
    -->

    <!-- For GENERATION tasks (producing content): -->
    <!--
    <format>
      - [Format specification 1]
      - [Format specification 2]
    </format>
    -->

    <output ref="[schema_field_name]">
      - [Expected output item 1]
      - [Expected output item 2]
      - [Expected output item 3]
    </output>
  </task>

  <task order="2" name="[task_name]">
    <description>[What this task accomplishes]</description>
    <analysis_points>
      - [Analysis point 1]
      - [Analysis point 2]
      - [Analysis point 3]
    </analysis_points>
    <output ref="[schema_field_name]">
      - [Expected output item 1]
      - [Expected output item 2]
    </output>
  </task>

  <task order="3" name="[task_name]">
    <description>[What this task accomplishes]</description>
    <output ref="[schema_field_name]">
      - [Expected output item 1]
      - [Expected output item 2]
    </output>
  </task>

  <!-- Add more tasks as needed -->
</tasks>

<!-- ============================================================
     STAGE ELEMENT 4: CONSTRAINTS
     Define the RULES that govern this stage's execution
     ============================================================ -->
<constraints>
  <!-- Hard constraints: MUST follow - violation = stage failure -->
  <hard_constraints>
    <constraint type="mandatory" id="1">[Rule that must be followed]</constraint>
    <constraint type="mandatory" id="2">[Another mandatory rule]</constraint>
    <constraint type="mandatory" id="3">[Another mandatory rule]</constraint>
  </hard_constraints>

  <!-- Soft constraints: SHOULD follow - deviation requires justification -->
  <soft_constraints>
    <constraint type="preferred" id="1">[Best practice to follow]</constraint>
    <constraint type="preferred" id="2">[Optimization target]</constraint>
  </soft_constraints>

  <!-- Boundaries: MUST NOT do - explicit prohibitions -->
  <boundaries>
    <avoid>[Anti-pattern or common mistake to avoid]</avoid>
    <avoid>[Another thing to explicitly not do]</avoid>
    <avoid>[Another prohibition]</avoid>
  </boundaries>
</constraints>

<!-- ============================================================
     STAGE ELEMENT 5: VALIDATION GATE
     Define the CHECKS that must pass before stage completion
     ============================================================ -->
<validation_gate>
  <!-- required="true": Must pass for handoff.ready = true -->
  <!-- required="false": Nice-to-have, noted if missing but doesn't block -->
  <check id="1" required="true">[Verifiable condition that must be true]</check>
  <check id="2" required="true">[Another required check]</check>
  <check id="3" required="true">[Another required check]</check>
  <check id="4" required="true">[Another required check]</check>
  <check id="5" required="false">[Optional enhancement check]</check>
</validation_gate>

<!-- ============================================================
     INPUT PLACEHOLDER
     This is where the actual input data will be injected at runtime
     ============================================================ -->
{{INPUT}}
